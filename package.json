{
  "name": "parse-unknown-codegen",
  "version": "0.2.1",
  "description": "Writes parse-unknown parsers from your types",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjsdev/parse-unknown-codegen.git"
  },
  "homepage": "https://github.com/wjsdev/parse-unknown-codegen#readme",
  "bugs": "https://github.com/wjsdev/parse-unknown-codegen/issues",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "parsers": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "tc": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "oxc-parser": "^0.152.0"
  },
  "peerDependencies": {
    "parse-unknown": "^0.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "parse-unknown": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
